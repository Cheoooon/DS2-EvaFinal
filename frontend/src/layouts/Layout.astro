---
import '../styles/global.css';
import ConfirmModal from '../components/ConfirmModal.astro';

interface Props {
  title: string;
  user?: { email: string } | null;
}

const { title, user } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950 text-slate-100 antialiased dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Sticker Collect</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col bg-slate-950 text-slate-100 selection:bg-sky-500 selection:text-white">
    <!-- Barra de Navegación Superior -->
    <header class="sticky top-0 z-40 bg-slate-900/95 backdrop-blur-md border-b border-slate-800 text-white transition-all shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo / Marca -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-xl shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform">
            🎴
          </div>
          <div>
            <span class="font-extrabold text-lg tracking-tight text-white group-hover:text-sky-300 transition-colors">
              Sticker<span class="text-sky-400">Collect</span>
            </span>
            <span class="hidden sm:inline-block ml-2 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider bg-sky-950 text-sky-300 border border-sky-800/60 rounded-full">
              Comunidad
            </span>
          </div>
        </a>

        <!-- Menú / Auth -->
        <nav class="flex items-center gap-3 sm:gap-4">
          {user ? (
            <div class="flex items-center gap-2 sm:gap-3">
              <a
                href="/community"
                class={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${
                  currentPath === '/community'
                    ? 'bg-slate-800 text-sky-400 border border-slate-700'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
                }`}
              >
                <span>🌐</span> <span class="hidden sm:inline">Comunidad</span>
              </a>

              <a
                href="/my-albums"
                class={`hidden sm:flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
                  currentPath.startsWith('/my-albums')
                    ? 'bg-slate-800 text-white border border-slate-700'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/60'
                }`}
              >
                <span>⚙️</span> Mis Álbumes
              </a>

              <div class="flex items-center gap-2 pl-2 border-l border-slate-800">
                <div class="hidden md:flex items-center gap-2 bg-slate-800/80 px-3 py-1.5 rounded-full border border-slate-700/60 text-xs">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-slate-300 font-medium truncate max-w-[160px]" title={user.email}>
                    {user.email}
                  </span>
                </div>

                <a
                  href="/api/auth/logout"
                  class="px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-red-300 hover:text-red-100 hover:bg-red-950/50 border border-red-900/40 transition-all flex items-center gap-1.5"
                  title="Cerrar Sesión"
                >
                  <span>🚪</span>
                  <span class="hidden sm:inline">Salir</span>
                </a>
              </div>
            </div>
          ) : (
            <div class="flex items-center gap-2.5">
              <a
                href="/login"
                class="px-3.5 py-2 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded-lg transition-colors"
              >
                Iniciar Sesión
              </a>
              <a
                href="/register"
                class="px-4 py-2 text-sm font-semibold bg-sky-500 hover:bg-sky-400 text-slate-950 rounded-lg shadow-sm shadow-sky-500/20 transition-all active:scale-95"
              >
                Registrarse
              </a>
            </div>
          )}
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <slot />
    </main>

    <!-- Footer Moderno -->
    <footer class="mt-auto border-t border-slate-800 bg-slate-900/60 backdrop-blur-sm py-6 text-center text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
        <p>© 2026 Sticker Collect · Plataforma de Láminas y Cromos</p>
        <p class="text-slate-400">Desarrollado con Astro & NestJS</p>
      </div>
    </footer>

    <!-- Diálogo Modal Global de Confirmación -->
    <ConfirmModal />

    <!-- Script Global de Efecto 3D Poke-Holo Tilt -->
    <script>
      function setupInteractiveCardTilt() {
        // Seleccionamos el wrapper contenedor estático en lugar de la tarjeta que se transforma
        const wrappers = document.querySelectorAll('.card-perspective-wrapper');

        wrappers.forEach((wrapper) => {
          if ((wrapper as any).__tiltInitialized) return;
          (wrapper as any).__tiltInitialized = true;

          const card = wrapper.querySelector('.interactive-card') as HTMLElement;
          if (!card) return;

          let rect: DOMRect | null = null;

          const onMouseEnter = () => {
            rect = wrapper.getBoundingClientRect();
            card.classList.add('is-active');
          };

          const onMouseMove = (e: MouseEvent) => {
            if (!rect) rect = wrapper.getBoundingClientRect();

            // Cálculo respecto al wrapper estático (evita desbordamiento en bordes)
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const percentX = ((x / rect.width) * 100).toFixed(1);
            const percentY = ((y / rect.height) * 100).toFixed(1);

            // Grados de inclinación Poke-Holo (eleva el extremo cercano al ratón)
            const maxDeg = 10;
            const rotX = (((y - centerY) / centerY) * maxDeg).toFixed(2);
            const rotY = (-((x - centerX) / centerX) * maxDeg).toFixed(2);

            // Ángulo de reflejo holográfico dinámico
            const rad = Math.atan2(y - centerY, x - centerX);
            const deg = ((rad * (180 / Math.PI)) + 90).toFixed(1);

            card.style.setProperty('--rot-x', `${rotX}deg`);
            card.style.setProperty('--rot-y', `${rotY}deg`);
            card.style.setProperty('--pointer-x', `${percentX}%`);
            card.style.setProperty('--pointer-y', `${percentY}%`);
            card.style.setProperty('--holo-angle', `${deg}deg`);
          };

          const onMouseLeave = () => {
            card.classList.remove('is-active');
            card.style.setProperty('--rot-x', '0deg');
            card.style.setProperty('--rot-y', '0deg');
            card.style.setProperty('--pointer-x', '50%');
            card.style.setProperty('--pointer-y', '50%');
            rect = null;
          };

          wrapper.addEventListener('mouseenter', onMouseEnter);
          wrapper.addEventListener('mousemove', onMouseMove as EventListener);
          wrapper.addEventListener('mouseleave', onMouseLeave);
        });
      }

      // Inicialización compatible con navegación Astro (View Transitions)
      document.addEventListener('DOMContentLoaded', setupInteractiveCardTilt);
      document.addEventListener('astro:page-load', setupInteractiveCardTilt);
      setupInteractiveCardTilt();
    </script>
  </body>
</html>