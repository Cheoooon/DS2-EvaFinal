---
interface Props {
  number: number;
  name: string;
  type: string;
  image?: string;
}

const { number, name, type, image } = Astro.props;
---

<div style="border: 1px dashed #cbd5e1; border-radius: 6px; padding: 12px; text-align: center; background: white;">
  <span style="font-size: 12px; font-weight: bold; color: #64748b;">#{number}</span>
  {image && <img src={image} alt={name} style="max-width: 100%; height: 80px; object-fit: contain; display: block; margin: 8px auto;" />}
  <h4 style="margin: 6px 0 4px 0; font-size: 14px;">{name}</h4>
  <span style="font-size: 10px; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; background: #f1f5f9; color: #334155;">
    {type}
  </span>
</div>