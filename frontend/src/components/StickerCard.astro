---
interface Props {
  id?: number;
  albumId?: number;
  number: number;
  name: string;
  type: string;
  image?: string;
  editable?: boolean;
}

const { id, albumId, number, name, type, image, editable = false } = Astro.props;
---

<div style="border: 1px dashed #cbd5e1; border-radius: 6px; padding: 12px; text-align: center; background: white; display: flex; flex-direction: column; justify-content: space-between; height: 100%; box-sizing: border-box;">
  <div>
    <span style="font-size: 12px; font-weight: bold; color: #64748b;">#{number}</span>
    {image ? (
      <img src={image} alt={name} style="width: 100%; height: 90px; object-fit: contain; display: block; margin: 8px 0;" />
    ) : (
      <div style="width: 100%; height: 90px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 12px; margin: 8px 0;">
        🖼️ Sin Imagen
      </div>
    )}
    <h4 style="margin: 4px 0; font-size: 14px;">{name}</h4>
    <span style="font-size: 10px; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; background: #f1f5f9; color: #334155;">
      {type}
    </span>
  </div>

  {editable && id && albumId && (
    <div style="margin-top: 10px; border-top: 1px solid #f1f5f9; padding-top: 8px;">
      <a href={`/my-albums/${albumId}/stickers/${id}/edit`} style="font-size: 12px; color: #0284c7; text-decoration: none; font-weight: bold;">✏️ Editar</a>
    </div>
  )}
</div>