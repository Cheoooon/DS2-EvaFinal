---
interface Props {
  id: number;
  name: string;
  description?: string;
  isShared: boolean;
  coverImage?: string;
  actionUrl?: string;  // Nueva propiedad opcional para el link
  actionText?: string; // Nueva propiedad opcional para el texto del botón
}

// Valores por defecto si no se los pasamos
const { 
  id, 
  name, 
  description, 
  isShared, 
  coverImage, 
  actionUrl = `/albums/${id}`, 
  actionText = 'Ver Detalles >' 
} = Astro.props;
---

<article style="border: 1px solid #cbd5e1; border-radius: 8px; padding: 16px; background: white; display: flex; flex-direction: column; justify-content: space-between;">
  <div>
    {coverImage ? (
      <img src={coverImage} alt={name} style="width: 100%; height: 140px; object-fit: cover; border-radius: 6px; margin-bottom: 12px;" />
    ) : (
      <div style="width: 100%; height: 140px; background: #e2e8f0; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: #64748b; font-weight: bold; margin-bottom: 12px;">
        📘 Sin Portada
      </div>
    )}
    <h3 style="margin: 0 0 8px 0;">{name}</h3>
    <p style="color: #64748b; font-size: 14px; margin-bottom: 12px;">{description || 'Sin descripción'}</p>
  </div>
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
    <span style={`font-size: 12px; padding: 2px 8px; border-radius: 4px; background: ${isShared ? '#dcfce7' : '#f1f5f9'}; color: ${isShared ? '#166534' : '#475569'};`}>
      {isShared ? 'Público' : 'Privado'}
    </span>
    
    <!-- Aquí usamos las nuevas propiedades -->
    <a href={actionUrl} style="color: #0284c7; text-decoration: none; font-weight: bold; font-size: 14px;">
      {actionText}
    </a>
  </div>
</article>