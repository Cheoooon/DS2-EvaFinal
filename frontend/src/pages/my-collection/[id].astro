---
import Layout from '../../layouts/Layout.astro';
import jwt from 'jsonwebtoken';

interface UserPayload { email: string; sub: number; }
const { id } = Astro.params;
const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

let user: UserPayload | null = null;
try {
  user = jwt.decode(token) as unknown as UserPayload;
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';

const [albumRes, bookRes] = await Promise.all([
  fetch(`${backendUrl}/albums/${id}`, { headers: { Authorization: `Bearer ${token}` } }),
  fetch(`${backendUrl}/collection/albums/${id}/book`, { headers: { Authorization: `Bearer ${token}` } }),
]);

const isAccessible = albumRes.ok && bookRes.ok;

let album = null;
let book = null;
let stats = null;

if (isAccessible) {
  album = await albumRes.json();
  book = await bookRes.json();
  stats = book.stats;
}
---

<Layout title={isAccessible ? `Mi Libro: ${album.name}` : "Álbum no accesible"} user={user}>
  <div style="margin-bottom: 20px;">
    <a href="/" style="color: #0284c7; text-decoration: none;">&larr; Volver al Inicio</a>
  </div>

  {!isAccessible ? (
    <div style="background: white; padding: 40px; border-radius: 8px; border: 1px solid #cbd5e1; text-align: center; max-width: 500px; margin: 40px auto;">
      <div style="font-size: 48px; margin-bottom: 16px;">🔒</div>
      <h2 style="margin: 0 0 12px 0; color: #0f172a;">Álbum No Disponible</h2>
      <p style="color: #64748b; margin-bottom: 24px;">
        Este álbum no existe o su propietario lo ha configurado como privado.
      </p>
      <div style="display: flex; justify-content: center; gap: 16px; align-items: center; flex-wrap: wrap;">
        <a href="/" style="display: inline-block; padding: 10px 20px; background: #0f172a; color: white; border-radius: 6px; text-decoration: none; font-weight: bold;">
          &larr; Volver a Mis Colecciones
        </a>
        
        <!-- Nuevo botón para quitar el álbum fantasma de la lista -->
        <form method="POST" action={`/api/collection/${id}/unfollow`} onsubmit="return confirm('¿Quitar este álbum de tu lista de colecciones?');">
          <button type="submit" style="padding: 10px 20px; background: #ef4444; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
            🗑️ Quitar de mi lista
          </button>
        </form>
      </div>
    </div>
  ) : (
    <>
      <!-- Cabecera y Barra de Estadísticas -->
      <header style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 30px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
          <h1 style="margin: 0;">📖 {album.name} - Mi Colección</h1>
          
          <div style="display: flex; gap: 12px; align-items: center;">
            <a href={`/albums/${id}`} style="padding: 8px 12px; background: #f1f5f9; color: #0f172a; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 14px; border: 1px solid #cbd5e1;">
              🔍 Ver Detalle del Álbum
            </a>
            <form method="POST" action={`/api/collection/${id}/unfollow`} onsubmit="return confirm('¿Dejar de coleccionar este álbum? Perderás el registro de tus láminas obtenidas.');">
              <button type="submit" style="padding: 8px 12px; background: #ef4444; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 14px;">
                🗑️ Dejar de Coleccionar
              </button>
            </form>
          </div>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; text-align: center;">
          <div style="background: #f8fafc; padding: 12px; border-radius: 6px; border: 1px solid #e2e8f0;">
            <span style="font-size: 12px; color: #64748b; font-weight: bold;">TOTAL</span>
            <div style="font-size: 20px; font-weight: bold; color: #0f172a;">{stats.total}</div>
          </div>
          <div style="background: #dcfce7; padding: 12px; border-radius: 6px; border: 1px solid #bbf7d0;">
            <span style="font-size: 12px; color: #166534; font-weight: bold;">OBTENIDAS</span>
            <div id="stat-collected" style="font-size: 20px; font-weight: bold; color: #15803d;">{stats.collected}</div>
          </div>
          <div style="background: #fef2f2; padding: 12px; border-radius: 6px; border: 1px solid #fecaca;">
            <span style="font-size: 12px; color: #991b1b; font-weight: bold;">FALTANTES</span>
            <div id="stat-missing" style="font-size: 20px; font-weight: bold; color: #dc2626;">{stats.missing}</div>
          </div>
          <div style="background: #fef9c3; padding: 12px; border-radius: 6px; border: 1px solid #fef08a;">
            <span style="font-size: 12px; color: #854d0e; font-weight: bold;">REPETIDAS</span>
            <div id="stat-duplicates" style="font-size: 20px; font-weight: bold; color: #a16207;">{stats.duplicates}</div>
          </div>
        </div>
      </header>

      <!-- Grilla de Láminas Interactivas -->
      <section style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 16px;">
        {book.stickers.map((s: any) => (
          <div
            id={`sticker-card-${s.id}`}
            style={`border: 2px solid ${s.is_owned ? '#22c55e' : '#cbd5e1'}; border-radius: 8px; padding: 12px; text-align: center; background: ${s.is_owned ? 'white' : '#f8fafc'}; opacity: ${s.is_owned ? '1' : '0.5'}; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.2s;`}
          >
            <div>
              <span style="font-size: 12px; font-weight: bold; color: #64748b;">#{s.number}</span>
              {s.image ? (
                <img src={`${backendUrl}${s.image}`} alt={s.name} style="width: 100%; height: 80px; object-fit: contain; margin: 8px 0;" />
              ) : (
                <div style="width: 100%; height: 80px; background: #e2e8f0; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 11px; margin: 8px 0;">
                  🖼️ Sin Imagen
                </div>
              )}
              <h4 style="margin: 4px 0; font-size: 13px;">{s.name}</h4>
            </div>

            <div style="margin-top: 10px; display: flex; align-items: center; justify-content: space-around; background: #f1f5f9; padding: 4px; border-radius: 6px;">
              <button
                class="action-btn"
                data-id={s.id}
                data-action="remove"
                style="background: #ef4444; color: white; border: none; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; font-weight: bold;"
              >-</button>
              
              <span id={`qty-${s.id}`} style="font-size: 14px; font-weight: bold; color: #0f172a;">
                {s.quantity}
              </span>
              
              <button
                class="action-btn"
                data-id={s.id}
                data-action="add"
                style="background: #22c55e; color: white; border: none; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; font-weight: bold;"
              >+</button>
            </div>
          </div>
        ))}
      </section>

      <script>
        const buttons = document.querySelectorAll('.action-btn');

        buttons.forEach((btn) => {
          btn.addEventListener('click', async (e) => {
            const target = e.currentTarget as HTMLButtonElement;
            const stickerId = target.dataset.id;
            const action = target.dataset.action;

            target.disabled = true;

            const qtyElem = document.getElementById(`qty-${stickerId}`);
            const oldQty = parseInt(qtyElem?.textContent || '0', 10);

            try {
              const res = await fetch(`/api/collection/stickers/${stickerId}/${action}`, {
                method: 'POST',
              });

              if (res.ok) {
                const data = await res.json();
                const newQty = data.quantity || 0;
                const cardElem = document.getElementById(`sticker-card-${stickerId}`);

                if (qtyElem && cardElem) {
                  qtyElem.textContent = newQty.toString();

                  if (newQty > 0) {
                    cardElem.style.borderColor = '#22c55e';
                    cardElem.style.opacity = '1';
                    cardElem.style.background = 'white';
                  } else {
                    cardElem.style.borderColor = '#cbd5e1';
                    cardElem.style.opacity = '0.5';
                    cardElem.style.background = '#f8fafc';
                  }
                }

                const statCollectedElem = document.getElementById('stat-collected');
                const statMissingElem = document.getElementById('stat-missing');
                const statDuplicatesElem = document.getElementById('stat-duplicates');

                if (statCollectedElem && statMissingElem && statDuplicatesElem) {
                  let currentCollected = parseInt(statCollectedElem.textContent || '0', 10);
                  let currentMissing = parseInt(statMissingElem.textContent || '0', 10);
                  let currentDuplicates = parseInt(statDuplicatesElem.textContent || '0', 10);

                  if (oldQty === 0 && newQty > 0) {
                    currentCollected += 1;
                    currentMissing -= 1;
                  } else if (oldQty > 0 && newQty === 0) {
                    currentCollected -= 1;
                    currentMissing += 1;
                  }

                  const oldDupeContrib = Math.max(0, oldQty - 1);
                  const newDupeContrib = Math.max(0, newQty - 1);
                  currentDuplicates += (newDupeContrib - oldDupeContrib);

                  statCollectedElem.textContent = currentCollected.toString();
                  statMissingElem.textContent = currentMissing.toString();
                  statDuplicatesElem.textContent = currentDuplicates.toString();
                }
              }
            } catch (error) {
              console.error("Error actualizando la lámina", error);
            } finally {
              target.disabled = false;
            }
          });
        });
      </script>
    </>
  )}
</Layout>