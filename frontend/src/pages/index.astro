---
import Layout from '../layouts/Layout.astro';
import AlbumCard from '../components/AlbumCard.astro';
import jwt from 'jsonwebtoken';

const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

let user: { email: string } | null = null;
try {
  user = jwt.decode(token) as unknown as { email: string };
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';

// Consultar álbumes públicos de la comunidad
let communityAlbums: Array<{ id: number; name: string; description: string; is_shared: boolean; cover_image?: string }> = [];
try {
  const res = await fetch(`${backendUrl}/albums/community`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (res.ok) {
    communityAlbums = await res.json();
  }
} catch (e) {
  console.error('Error al obtener álbumes de la comunidad:', e);
}
---

<Layout title="Inicio" user={user}>
  <!-- Banner de Navegación Rápida -->
  <section style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h2 style="margin: 0 0 8px 0;">¿Quieres crear tu propia colección?</h2>
      <p style="margin: 0; color: #64748b;">Administra tus álbumes, sube láminas y compártelos con la comunidad.</p>
    </div>
    <a href="/my-albums" style="padding: 12px 20px; background: #0f172a; color: white; border-radius: 6px; text-decoration: none; font-weight: bold; white-space: nowrap;">
      ⚙️ Ir a Mis Álbumes Creados
    </a>
  </section>

  <!-- Álbumes Públicos de la Comunidad -->
  <section>
    <h2 style="margin-bottom: 16px;">🌐 Álbumes de la Comunidad</h2>
    {communityAlbums.length === 0 ? (
      <p style="color: #64748b; background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
        Aún no hay álbumes públicos compartidos por la comunidad.
      </p>
    ) : (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
        {communityAlbums.map((album) => (
          <AlbumCard
            id={album.id}
            name={album.name}
            description={album.description}
            isShared={album.is_shared}
            coverImage={album.cover_image ? `${backendUrl}${album.cover_image}` : undefined}
          />
        ))}
      </div>
    )}
  </section>

  <!-- Álbumes subscritos -->

</Layout>