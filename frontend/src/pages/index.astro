---
import Layout from '../layouts/Layout.astro';
import AlbumCard from '../components/AlbumCard.astro';
import jwt from 'jsonwebtoken';

interface UserPayload { email: string; sub: number; }
const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

let user: UserPayload | null = null;
try {
  user = jwt.decode(token) as unknown as UserPayload;
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';

// Hacemos ambas peticiones en paralelo: Comunidad y Seguídos
const [communityRes, followedRes] = await Promise.all([
  fetch(`${backendUrl}/albums/community`, { headers: { Authorization: `Bearer ${token}` } }),
  fetch(`${backendUrl}/collection/my-followed`, { headers: { Authorization: `Bearer ${token}` } })
]);

const communityAlbums: any[] = communityRes.ok ? await communityRes.json() : [];
const followedAlbums: any[] = followedRes.ok ? await followedRes.json() : [];

// Filtramos de la comunidad aquellos que ya estamos siguiendo para no repetirlos visualmente
const followedIds = followedAlbums.map(a => a.id);
const discoverAlbums = communityAlbums.filter(a => !followedIds.includes(a.id));
---

<Layout title="Dashboard" user={user}>
  <section style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h2 style="margin: 0 0 8px 0;">Panel de Creador</h2>
      <p style="margin: 0; color: #64748b;">Administra tus álbumes, sube láminas y compártelos.</p>
    </div>
    <a href="/my-albums" style="padding: 10px 16px; background: #0f172a; color: white; border-radius: 6px; text-decoration: none; font-weight: bold;">
      ⚙️ Mis Álbumes Creados
    </a>
  </section>

<!-- Álbumes que estoy coleccionando -->
  <section style="margin-bottom: 40px;">
    <h2 style="margin-bottom: 16px;">📚 Mis Colecciones Activas</h2>
    {followedAlbums.length === 0 ? (
      <p style="color: #64748b; background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
        Aún no has empezado ninguna colección. ¡Explora la comunidad abajo!
      </p>
    ) : (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;">
        {followedAlbums.map((album) => (
          <AlbumCard
            id={album.id}
            name={album.name}
            description={album.description}
            isShared={album.is_shared}
            coverImage={album.cover_image ? `${backendUrl}${album.cover_image}` : undefined}
            actionUrl={`/my-collection/${album.id}`}
            actionText="📖 Abrir Libro"
          />
        ))}
      </div>
    )}
  </section>

  <!-- Explorar nuevos álbumes -->
  <section>
    <h2 style="margin-bottom: 16px;">🌐 Descubrir en la Comunidad</h2>
    {discoverAlbums.length === 0 ? (
      <p style="color: #64748b;">No hay colecciones nuevas por descubrir en este momento.</p>
    ) : (
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; opacity: 0.9;">
        {discoverAlbums.map((album) => (
          <AlbumCard
            id={album.id}
            name={album.name}
            description={album.description}
            isShared={album.is_shared}
            coverImage={album.cover_image ? `${backendUrl}${album.cover_image}` : undefined}
            actionUrl={`/albums/${album.id}`}
            actionText="Ver Álbum >"
          />
        ))}
      </div>
    )}
  </section>
</Layout>