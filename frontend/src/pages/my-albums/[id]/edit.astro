---
import Layout from '../../../layouts/Layout.astro';
import jwt from 'jsonwebtoken';

const { id } = Astro.params;
const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

interface UserPayload {
  email: string;
  sub: number;
}

let user: UserPayload | null = null;
try {
  user = jwt.decode(token) as unknown as UserPayload;
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';
const res = await fetch(`${backendUrl}/albums/${id}`, {
  headers: { Authorization: `Bearer ${token}` },
});

if (!res.ok) return Astro.redirect('/my-albums');
const album = await res.json();

if (album.owner?.id !== user?.sub) return Astro.redirect('/');
---

<Layout title={`Editar ${album.name}`} user={user}>
  <div style="margin-bottom: 20px;">
    <a href={`/my-albums/${id}`} style="color: #0284c7; text-decoration: none;">&larr; Volver al Álbum</a>
  </div>

  <div style="max-width: 500px; margin: 0 auto; background: white; padding: 24px; border-radius: 8px; border: 1px solid #cbd5e1;">
    <h2>Editar Álbum</h2>
    
    <form method="POST" action={`/api/albums/${id}/update`} enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 16px;">
      <div>
        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Nombre:</label>
        <input type="text" name="name" value={album.name} required style="width: 100%; padding: 8px; box-sizing: border-box;" />
      </div>
      <div>
        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Descripción:</label>
        <textarea name="description" rows="3" style="width: 100%; padding: 8px; box-sizing: border-box;">{album.description}</textarea>
      </div>
      <div>
        <label style="display: block; font-weight: bold; margin-bottom: 4px;">Cambiar Portada:</label>
        <input type="file" name="cover" accept="image/*" style="width: 100%;" />
      </div>
      <label style="display: flex; align-items: center; gap: 8px;">
        <input type="checkbox" name="is_shared" checked={album.is_shared} /> Compartir públicamente con la comunidad
      </label>
      <button type="submit" style="padding: 10px; background: #0f172a; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
        Guardar Cambios
      </button>
    </form>

    <hr style="margin: 24px 0; border: 0; border-top: 1px solid #e2e8f0;" />

    <form method="POST" action={`/api/albums/${id}/delete`} onsubmit="return confirm('¿Seguro que deseas eliminar este álbum?');">
      <button type="submit" style="width: 100%; padding: 10px; background: #ef4444; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
        🗑️ Eliminar Álbum
      </button>
    </form>
  </div>
</Layout>