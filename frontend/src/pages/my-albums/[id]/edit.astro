---
import Layout from '../../../layouts/Layout.astro';
import jwt from 'jsonwebtoken';

const { id } = Astro.params;
const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

interface UserPayload {
  email: string;
  sub: number;
}

let user: UserPayload | null = null;
try {
  user = jwt.decode(token) as unknown as UserPayload;
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';
const res = await fetch(`${backendUrl}/albums/${id}`, {
  headers: { Authorization: `Bearer ${token}` },
});

if (!res.ok) return Astro.redirect('/my-albums');
const album = await res.json();

if (album.owner?.id !== user?.sub) return Astro.redirect('/');
---

<Layout title={`Editar ${album.name}`} user={user}>
  <div class="mb-6">
    <a href={`/my-albums/${id}`} class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-400 hover:text-white transition-colors">
      <span>&larr;</span>
      <span>Volver al Álbum</span>
    </a>
  </div>

  <div class="max-w-xl mx-auto space-y-6">
    <!-- Card Principal: Edición -->
    <div class="bg-slate-900/90 backdrop-blur-md rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-2xl shadow-black/50">
      <div class="flex items-center gap-3 mb-6 pb-6 border-b border-slate-800">
        <div class="w-12 h-12 rounded-2xl bg-sky-500/10 text-sky-400 flex items-center justify-center text-2xl border border-sky-500/20">
          ✏️
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Editar Álbum</h1>
          <p class="text-xs sm:text-sm text-slate-400">Actualiza los datos y la portada de tu colección</p>
        </div>
      </div>

      <form method="POST" action={`/api/albums/${id}/update`} enctype="multipart/form-data" class="space-y-6">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
            Nombre del Álbum <span class="text-rose-400">*</span>
          </label>
          <input
            type="text"
            name="name"
            value={album.name}
            required
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder:text-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all text-sm"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
            Descripción
          </label>
          <textarea
            name="description"
            rows="3"
            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder:text-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all text-sm"
          >{album.description}</textarea>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
            Cambiar Foto de Portada <span class="text-xs font-normal text-slate-500 lowercase">(opcional)</span>
          </label>
          {album.cover_image && (
            <div class="mb-3 flex items-center gap-3 p-2 bg-slate-950 rounded-xl border border-slate-800">
              <img src={`${backendUrl}${album.cover_image}`} alt={album.name} class="w-12 h-12 object-cover rounded-lg" />
              <span class="text-xs text-slate-400">Portada actual asignada. Sube un archivo nuevo para reemplazarla.</span>
            </div>
          )}
          <input
            type="file"
            name="cover"
            accept="image/*"
            class="w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-200 hover:file:bg-slate-700 cursor-pointer border border-dashed border-slate-800 rounded-xl p-2 bg-slate-950/50"
          />
        </div>

        <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
          <label class="flex items-center gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="is_shared"
              checked={album.is_shared}
              class="w-5 h-5 rounded-md text-sky-500 focus:ring-sky-500/20 border-slate-700 bg-slate-900 transition cursor-pointer"
            />
            <div>
              <span class="block text-sm font-bold text-slate-200">Compartir públicamente con la comunidad</span>
              <span class="block text-xs text-slate-400">Permite que otros usuarios descubran y coleccionen este álbum.</span>
            </div>
          </label>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="w-full py-3.5 px-4 rounded-xl bg-sky-400 hover:bg-sky-300 text-slate-950 font-black text-sm shadow-lg shadow-sky-500/20 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
          >
            Guardar Cambios
          </button>
        </div>
      </form>
    </div>

    <!-- Zona Peligrosa / Eliminar Álbum -->
    <div class="bg-rose-950/20 rounded-3xl p-6 border border-rose-900/40">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-sm font-bold text-rose-300">Zona de Peligro</h3>
          <p class="text-xs text-rose-400/80 mt-0.5">
            Eliminar permanentemente este álbum y todas sus láminas registradas.
          </p>
        </div>

        <form
          method="POST"
          action={`/api/albums/${id}/delete`}
          data-confirm="¿Estás completamente seguro de eliminar este álbum? Esta acción no se puede deshacer y se borrarán todas sus láminas asociadas."
          data-confirm-title="Eliminar Álbum Definitivamente"
          data-confirm-btn="Sí, eliminar álbum"
          class="flex-shrink-0"
        >
          <button
            type="submit"
            class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-rose-900/60 hover:bg-rose-800 text-rose-200 border border-rose-700/60 font-bold text-xs shadow-sm transition-all cursor-pointer"
          >
            🗑️ Eliminar Álbum
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>