---
import Layout from '../../../../layouts/Layout.astro';
import jwt from 'jsonwebtoken';

const { id } = Astro.params;
const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

interface UserPayload {
  email: string;
  sub: number;
}

let user: UserPayload | null = null;
try {
  user = jwt.decode(token) as unknown as UserPayload;
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';
const res = await fetch(`${backendUrl}/albums/${id}`, {
  headers: { Authorization: `Bearer ${token}` },
});

if (!res.ok) return Astro.redirect('/my-albums');
const album = await res.json();

if (album.owner?.id !== user?.sub) return Astro.redirect('/');

const errorParam = Astro.url.searchParams.get('error');
---

<Layout title={`Cargar Láminas · ${album.name}`} user={user}>
  <div class="mb-6">
    <a href={`/my-albums/${id}`} class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-400 hover:text-white transition-colors">
      <span>&larr;</span>
      <span>Volver a {album.name}</span>
    </a>
  </div>

  <div class="bg-slate-900/90 backdrop-blur-md rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-2xl shadow-black/50 mb-10">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-6 border-b border-slate-800">
      <div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
          ➕ Cargar Láminas a {album.name}
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Añade una o varias láminas a la vez indicando su número, nombre, tipo e imagen.
        </p>
      </div>

      <button
        type="button"
        id="add-row-btn"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold text-sky-400 bg-sky-500/10 hover:bg-sky-500/20 border border-sky-500/30 transition-all cursor-pointer self-start sm:self-auto"
      >
        <span>➕</span>
        <span>Añadir otra fila</span>
      </button>
    </div>

    {errorParam === 'empty_data' && (
      <div class="mb-6 p-4 rounded-xl bg-rose-950/40 border border-rose-500/30 text-rose-300 text-sm flex items-center gap-3">
        <span class="text-lg">⚠️</span>
        <span>Debes completar al menos una lámina con número y nombre válidos antes de guardar.</span>
      </div>
    )}

    <form method="POST" action={`/api/albums/${id}/stickers`} enctype="multipart/form-data">
      <div class="overflow-x-auto rounded-2xl border border-slate-800 mb-6">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-950/80 text-slate-300 text-xs uppercase font-bold tracking-wider border-b border-slate-800">
            <tr>
              <th class="px-4 py-3.5 w-24">N°</th>
              <th class="px-4 py-3.5 min-w-[200px]">Nombre de Lámina</th>
              <th class="px-4 py-3.5 w-44">Tipo</th>
              <th class="px-4 py-3.5 min-w-[220px]">Foto (Opcional)</th>
              <th class="px-4 py-3.5 w-16 text-center">Acción</th>
            </tr>
          </thead>
          <tbody id="stickers-rows" class="divide-y divide-slate-800 bg-slate-900/50">
            <!-- Filas inyectadas dinámicamente -->
          </tbody>
        </table>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
        <span class="text-xs text-slate-400">
          Tip: Puedes crear secuencias rápidas agregando más filas consecutivas.
        </span>

        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            href={`/my-albums/${id}`}
            class="w-full sm:w-auto px-5 py-3 rounded-xl border border-slate-700/80 text-slate-300 text-sm font-semibold hover:bg-slate-800 hover:text-white text-center transition-colors"
          >
            Cancelar
          </a>
          <button
            type="submit"
            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-sky-400 hover:bg-sky-300 text-slate-950 font-black text-sm shadow-lg shadow-sky-500/20 transition-all cursor-pointer text-center hover:scale-[1.01] active:scale-[0.99]"
          >
            Guardar Láminas
          </button>
        </div>
      </div>
    </form>
  </div>

  <script>
    const container = document.getElementById('stickers-rows');
    const addBtn = document.getElementById('add-row-btn');
    let rowCount = 0;

    function addRow() {
      const tr = document.createElement('tr');
      tr.className = 'hover:bg-slate-800/40 transition-colors';
      const index = rowCount;

      tr.innerHTML = `
        <td class="px-4 py-3">
          <input
            type="number"
            name="number_${index}"
            value="${index + 1}"
            min="1"
            required
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm font-bold focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"
          />
        </td>
        <td class="px-4 py-3">
          <input
            type="text"
            name="name_${index}"
            placeholder="Ej: Escudo Nacional, Jugador Estrella..."
            required
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder:text-slate-500 text-sm focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"
          />
        </td>
        <td class="px-4 py-3">
          <select
            name="type_${index}"
            class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20"
          >
            <option value="normal" class="bg-slate-900 text-white">Normal</option>
            <option value="holografica" class="bg-slate-900 text-white">✨ Holográfica</option>
            <option value="especial" class="bg-slate-900 text-white">⭐ Especial</option>
          </select>
        </td>
        <td class="px-4 py-3">
          <input
            type="file"
            name="image_${index}"
            accept="image/*"
            class="w-full text-xs text-slate-400 file:mr-2.5 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-200 hover:file:bg-slate-700 cursor-pointer"
          />
        </td>
        <td class="px-4 py-3 text-center">
          <button
            type="button"
            class="remove-btn w-8 h-8 rounded-lg bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 border border-rose-500/30 transition-colors inline-flex items-center justify-center text-xs font-bold cursor-pointer"
            title="Eliminar fila"
          >
            ✕
          </button>
        </td>
      `;

      tr.querySelector('.remove-btn')?.addEventListener('click', () => {
        tr.remove();
        reindexRows();
      });

      container?.appendChild(tr);
      rowCount++;
    }

    function reindexRows() {
      const rows = container?.querySelectorAll('tr');
      rows?.forEach((row, i) => {
        row.querySelector('input[name^="number_"]')?.setAttribute('name', `number_${i}`);
        row.querySelector('input[name^="name_"]')?.setAttribute('name', `name_${i}`);
        row.querySelector('select[name^="type_"]')?.setAttribute('name', `type_${i}`);
        row.querySelector('input[name^="image_"]')?.setAttribute('name', `image_${i}`);
      });
      rowCount = rows ? rows.length : 0;
    }

    if (container && container.children.length === 0) {
      addRow();
    }

    addBtn?.addEventListener('click', addRow);
  </script>
</Layout>