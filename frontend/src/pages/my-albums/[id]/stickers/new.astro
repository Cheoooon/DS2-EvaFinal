---
import Layout from '../../../../layouts/Layout.astro';
import jwt from 'jsonwebtoken';

const { id } = Astro.params;
const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

interface UserPayload {
  email: string;
  sub: number;
}

let user: UserPayload | null = null;
try {
  user = jwt.decode(token) as unknown as UserPayload;
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';
const res = await fetch(`${backendUrl}/albums/${id}`, {
  headers: { Authorization: `Bearer ${token}` },
});

if (!res.ok) return Astro.redirect('/my-albums');
const album = await res.json();

if (album.owner?.id !== user?.sub) return Astro.redirect('/');

const errorParam = Astro.url.searchParams.get('error');
---

<Layout title={`Cargar Láminas - ${album.name}`} user={user}>
  <div style="margin-bottom: 20px;">
    <a href={`/my-albums/${id}`} style="color: #0284c7; text-decoration: none;">&larr; Volver a {album.name}</a>
  </div>

  <div style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #cbd5e1; margin-bottom: 30px;">
    <h1 style="margin-top: 0; margin-bottom: 8px;">➕ Agregar Láminas a {album.name}</h1>
    <p style="color: #64748b; margin-top: 0; margin-bottom: 20px;">
      Puedes añadir una o múltiples láminas a la vez. Cada lámina puede incluir su tipo y una imagen opcional.
    </p>

    {errorParam === 'empty_data' && (
      <div style="background: #fef2f2; color: #991b1b; padding: 12px; border-radius: 6px; margin-bottom: 20px;">
        Debes completar al menos una lámina válida antes de guardar.
      </div>
    )}

    <form method="POST" action={`/api/albums/${id}/stickers`} enctype="multipart/form-data">
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
          <thead>
            <tr style="text-align: left; background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
              <th style="padding: 10px; width: 80px;">N°</th>
              <th style="padding: 10px;">Nombre</th>
              <th style="padding: 10px; width: 140px;">Tipo</th>
              <th style="padding: 10px; width: 220px;">Foto (Opcional)</th>
              <th style="padding: 10px; width: 60px; text-align: center;">Acción</th>
            </tr>
          </thead>
          <tbody id="stickers-rows">
            <!-- Filas inyectadas dinámicamente -->
          </tbody>
        </table>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end;">
        <button type="button" id="add-row-btn" style="padding: 10px 16px; background: #0284c7; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
          ➕ Añadir otra fila
        </button>
        <button type="submit" style="padding: 10px 20px; background: #0f172a; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">
          Guardar Láminas
        </button>
      </div>
    </form>
  </div>

  <script>
    const container = document.getElementById('stickers-rows');
    const addBtn = document.getElementById('add-row-btn');
    let rowCount = 0;

    function addRow() {
      const tr = document.createElement('tr');
      tr.style.borderBottom = '1px solid #f1f5f9';
      const index = rowCount;

      tr.innerHTML = `
        <td style="padding: 8px;">
          <input type="number" name="number_${index}" value="${index + 1}" min="1" required style="width: 100%; padding: 6px; box-sizing: border-box;" />
        </td>
        <td style="padding: 8px;">
          <input type="text" name="name_${index}" placeholder="Ej: Escudo Nacional" required style="width: 100%; padding: 6px; box-sizing: border-box;" />
        </td>
        <td style="padding: 8px;">
          <select name="type_${index}" style="width: 100%; padding: 6px; box-sizing: border-box;">
            <option value="normal">Normal</option>
            <option value="holografica">Holográfica</option>
            <option value="especial">Especial</option>
          </select>
        </td>
        <td style="padding: 8px;">
          <input type="file" name="image_${index}" accept="image/*" style="font-size: 12px; width: 100%;" />
        </td>
        <td style="padding: 8px; text-align: center;">
          <button type="button" class="remove-btn" style="background: #ef4444; color: white; border: none; padding: 6px 10px; border-radius: 4px; cursor: pointer;">❌</button>
        </td>
      `;

      tr.querySelector('.remove-btn')?.addEventListener('click', () => {
        tr.remove();
        reindexRows();
      });

      container?.appendChild(tr);
      rowCount++;
    }

    function reindexRows() {
      const rows = container?.querySelectorAll('tr');
      rows?.forEach((row, i) => {
        row.querySelector('input[name^="number_"]')?.setAttribute('name', `number_${i}`);
        row.querySelector('input[name^="name_"]')?.setAttribute('name', `name_${i}`);
        row.querySelector('select[name^="type_"]')?.setAttribute('name', `type_${i}`);
        row.querySelector('input[name^="image_"]')?.setAttribute('name', `image_${i}`);
      });
      rowCount = rows ? rows.length : 0;
    }

    if (container && container.children.length === 0) {
      addRow();
    }

    addBtn?.addEventListener('click', addRow);
  </script>
</Layout>