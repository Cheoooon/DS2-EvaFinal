---
import Layout from '../../layouts/Layout.astro';
import jwt from 'jsonwebtoken';

const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

interface UserPayload {
  email: string;
}

let user: UserPayload | null = null;
try {
  user = jwt.decode(token) as unknown as UserPayload;
} catch {
  return Astro.redirect('/login');
}
---

<Layout title="Crear Álbum" user={user}>
  <div class="mb-6">
    <a href="/my-albums" class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-400 hover:text-white transition-colors">
      <span>&larr;</span>
      <span>Volver a Mis Álbumes</span>
    </a>
  </div>

  <div class="max-w-xl mx-auto bg-slate-900/90 backdrop-blur-md rounded-3xl p-8 sm:p-10 border border-slate-800 shadow-2xl shadow-black/50">
    <div class="flex items-center gap-3 mb-6 pb-6 border-b border-slate-800">
      <div class="w-12 h-12 rounded-2xl bg-sky-500/10 text-sky-400 flex items-center justify-center text-2xl border border-sky-500/20">
        ✨
      </div>
      <div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Nuevo Álbum</h1>
        <p class="text-xs sm:text-sm text-slate-400">Crea una nueva colección de láminas para tu inventario</p>
      </div>
    </div>

    <form method="POST" action="/api/albums/create" enctype="multipart/form-data" class="space-y-6">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
          Nombre del Álbum <span class="text-rose-400">*</span>
        </label>
        <input
          type="text"
          name="name"
          required
          placeholder="Ej: Copa Mundial 2026, Mitología Nórdica..."
          class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder:text-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all text-sm"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
          Descripción
        </label>
        <textarea
          name="description"
          rows="3"
          placeholder="Describe la temática, rarezas o historia de esta colección..."
          class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder:text-slate-500 focus:outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-500/20 transition-all text-sm"
        ></textarea>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">
          Foto de Portada <span class="text-xs font-normal text-slate-500 lowercase">(opcional)</span>
        </label>
        <input
          type="file"
          name="cover"
          accept="image/*"
          class="w-full text-xs text-slate-400 file:mr-4 file:py-2.5 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-slate-800 file:text-slate-200 hover:file:bg-slate-700 cursor-pointer border border-dashed border-slate-800 rounded-xl p-2 bg-slate-950/50"
        />
      </div>

      <div class="p-4 rounded-2xl bg-slate-950/60 border border-slate-800">
        <label class="flex items-center gap-3 cursor-pointer">
          <input
            type="checkbox"
            name="is_shared"
            class="w-5 h-5 rounded-md text-sky-500 focus:ring-sky-500/20 border-slate-700 bg-slate-900 transition cursor-pointer"
          />
          <div>
            <span class="block text-sm font-bold text-slate-200">Compartir públicamente con la comunidad</span>
            <span class="block text-xs text-slate-400">Cualquier usuario podrá descubrir tu álbum y comenzar su propia colección.</span>
          </div>
        </label>
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full py-3.5 px-4 rounded-xl bg-sky-400 hover:bg-sky-300 text-slate-950 font-black text-sm shadow-lg shadow-sky-500/20 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
        >
          Guardar y Crear Álbum
        </button>
      </div>
    </form>
  </div>
</Layout>