---
import Layout from '../../layouts/Layout.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import jwt from 'jsonwebtoken';

const token = Astro.cookies.get('jwt')?.value;
if (!token) return Astro.redirect('/login');

let user: { email: string } | null = null;
try {
  user = jwt.decode(token) as unknown as { email: string };
} catch {
  return Astro.redirect('/login');
}

const backendUrl = import.meta.env.BACKEND_URL || 'http://localhost:3000';
const res = await fetch(`${backendUrl}/albums/my-albums`, {
  headers: { Authorization: `Bearer ${token}` },
});

const albums: Array<{ id: number; name: string; description: string; is_shared: boolean; cover_image?: string }> = res.ok ? await res.json() : [];
---

<Layout title="Mis Álbumes Creados" user={user}>

  <div class="flex items-center justify-between gap-4 mb-6">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-400 hover:text-slate-100 transition-colors"
    >
      <span>&larr;</span>
      <span>Volver al Dashboard</span>
    </a>
  </div>

  <!-- Top Bar / Encabezado -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
        Panel del Creador: Mis Álbumes
      </h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">
        Diseña y gestiona tus colecciones, edita detalles y administra sus láminas.
      </p>
    </div>

    <a
      href="/my-albums/new"
      class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-sky-400 hover:bg-sky-300 text-slate-950 text-sm font-black shadow-lg shadow-sky-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all"
    >
      <span>➕</span>
      <span>Crear Nuevo Álbum</span>
    </a>
  </div>

  <!-- Grid de Álbumes Creados -->
  {albums.length === 0 ? (
    <div class="bg-slate-900/60 rounded-3xl border border-dashed border-slate-800 p-12 text-center max-w-lg mx-auto shadow-2xl shadow-black/50">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 flex items-center justify-center text-3xl mb-4">
        📁
      </div>
      <h3 class="text-lg font-bold text-white mb-1">No has creado ningún álbum todavía</h3>
      <p class="text-sm text-slate-400 mb-6 leading-relaxed">
        Empieza creando tu primera colección para subir tus láminas personalizadas y compartirlas con otros coleccionistas.
      </p>
      <a
        href="/my-albums/new"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sky-400 hover:bg-sky-300 text-slate-950 text-sm font-black shadow-lg shadow-sky-500/20 hover:scale-[1.02] active:scale-[0.98] transition-all"
      >
        <span>➕</span>
        <span>Crear mi primer álbum</span>
      </a>
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {albums.map((album) => (
        <AlbumCard
          id={album.id}
          name={album.name}
          description={album.description}
          isShared={album.is_shared}
          coverImage={album.cover_image ? `${backendUrl}${album.cover_image}` : undefined}
          actionUrl={`/my-albums/${album.id}`}
          actionText="Administrar"
        />
      ))}
    </div>
  )}
</Layout>