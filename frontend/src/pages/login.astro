---
import Layout from '../layouts/Layout.astro';

if (Astro.cookies.has('jwt')) return Astro.redirect('/');
const hasError = Astro.url.searchParams.get('error') === 'invalid_credentials';
---

<Layout title="Iniciar Sesión">
  <div style="max-width: 400px; margin: 0 auto;">
    <h1>Iniciar Sesión</h1>
    {hasError && <p style="color: #ef4444;">Credenciales incorrectas</p>}

    <form method="POST" action="/api/auth/login">
      <div style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px;">Email:</label>
        <input type="email" name="email" required style="width: 100%; padding: 8px; box-sizing: border-box;" />
      </div>
      <div style="margin-bottom: 15px;">
        <label style="display: block; margin-bottom: 5px;">Contraseña:</label>
        <input type="password" name="password" required style="width: 100%; padding: 8px; box-sizing: border-box;" />
      </div>
      <button type="submit" style="width: 100%; padding: 10px; background: #0f172a; color: white; border: none; cursor: pointer;">Entrar</button>
    </form>
    <p>¿No tienes cuenta? <a href="/register">Regístrate aquí</a></p>
  </div>
</Layout>