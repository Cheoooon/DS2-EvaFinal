---
import Layout from '../layouts/Layout.astro';

if (Astro.cookies.has('jwt')) return Astro.redirect('/');
const hasError = Astro.url.searchParams.get('error') === 'invalid_credentials';
---

<Layout title="Iniciar Sesión">
  <div class="min-h-[70vh] flex items-center justify-center py-6 px-4">
    <div class="w-full max-w-md">
      <!-- Card de Login -->
      <div class="bg-slate-900 rounded-3xl p-8 sm:p-10 shadow-xl shadow-black/40 border border-slate-800">
        <div class="text-center mb-8">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-2xl shadow-md shadow-sky-500/25 mb-4">
            🎴
          </div>
          <h1 class="text-2xl font-extrabold text-slate-100 tracking-tight">Bienvenido de nuevo</h1>
          <p class="text-sm text-slate-400 mt-1">Ingresa a tu cuenta de Sticker Collect</p>
        </div>

        {hasError && (
          <div class="mb-6 p-4 rounded-xl bg-red-950/60 border border-red-800/70 text-red-300 text-sm flex items-center gap-3">
            <span class="text-lg">⚠️</span>
            <span>Credenciales incorrectas. Verifica tu email y contraseña.</span>
          </div>
        )}

        <form method="POST" action="/api/auth/login" class="space-y-5">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">
              Correo Electrónico
            </label>
            <div class="relative">
              <input
                type="email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-slate-100 placeholder:text-slate-500 focus:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all text-sm"
              />
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">
                Contraseña
              </label>
            </div>
            <div class="relative">
              <input
                type="password"
                name="password"
                required
                placeholder="••••••••"
                class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-slate-100 placeholder:text-slate-500 focus:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all text-sm"
              />
            </div>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-4 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm shadow-md shadow-sky-500/25 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 active:scale-[0.99] transition-all cursor-pointer"
          >
            Iniciar Sesión
          </button>
        </form>

        <div class="mt-8 pt-6 border-t border-slate-800 text-center">
          <p class="text-sm text-slate-400">
            ¿Aún no tienes una cuenta?{' '}
            <a href="/register" class="font-bold text-sky-400 hover:text-sky-300 hover:underline">
              Regístrate gratis
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>